{
  "name": "opencode-harness-runtime",
  "version": "0.1.12",
  "description": "No-copy external runtime launcher for the OpenCode delegation harness",
  "type": "module",
  "private": false,
  "bin": {
    "opencode-harness": "bin/opencode-harness.mjs"
  },
  "files": [
    "README.md",
    "bin/opencode-harness.mjs",
    ".opencode/runtime.manifest.json",
    ".opencode/agents",
    ".opencode/agents/researcher.md",
    ".opencode/commands/delegate-*.md",
    ".opencode/skills/delegation-orchestrator/SKILL.md",
    ".opencode/skills/delegation-orchestrator/references/role-routing-matrix.md",
    ".opencode/skills/delegation-orchestrator/references/trust-and-restart-guide.md",
    ".opencode/skills/delegation-orchestrator/references/validation-checklist.md",
    ".opencode/contracts",
    ".opencode/schemas",
    ".opencode/routing/harness-model-routing.example.json",
    ".opencode/routing/harness-model-routing.local.example.json",
    ".opencode/routing/model-routing-helper.mjs",
    ".opencode/routing/resolve-model-routing.mjs",
    ".opencode/routing/routing-config-loader.mjs",
    ".opencode/routing/routing-policy.mjs",
    ".opencode/plugins",
    ".opencode/plugin-modules/harness-lifecycle.js",
    ".opencode/plugin-modules/task-thread-policy.js",
    ".opencode/plugin-modules/role-model-routing-enforcement.js",
    ".opencode/plugin-modules/trace-root-permissions.js",
    ".opencode/bootstrap/memory/INDEX.md",
    ".opencode/bootstrap/memory/protocols/memory-management.md",
    ".opencode/bootstrap/memory/templates/orchestration-index.md",
    ".opencode/bootstrap/memory/templates/role-trace-artifact.md"
  ],
  "os": [
    "linux"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check:format": "prettier --check 'eslint.config.mjs' 'bin/**/*.ts' '.opencode/src/**/*.ts' '.opencode/scripts/*.mts' && eslint 'bin/**/*.ts' '.opencode/src/**/*.ts' '.opencode/scripts/*.mts'",
    "format": "prettier --write 'eslint.config.mjs' 'bin/**/*.ts' '.opencode/src/**/*.ts' '.opencode/scripts/*.mts' && eslint --fix 'bin/**/*.ts' '.opencode/src/**/*.ts' '.opencode/scripts/*.mts'",
    "typecheck": "tsc --noEmit",
    "compile": "tsc --outDir .build/typescript",
    "build": "node .opencode/scripts/build-typescript.mts",
    "check:generated": "node .opencode/scripts/build-typescript.mts --check",
    "check:source-policy": "node .opencode/scripts/check-typescript-policy.mts",
    "test:harness": "node .opencode/src/routing/routing-policy.test.ts && node --test .opencode/src/plugin-modules/task-thread-policy.test.ts && node --test .opencode/src/plugin-modules/trace-root-permissions.test.ts && node --test .opencode/scripts/darwin-portable-fs.test.mts && node --test .opencode/scripts/runtime-harness.test.mts && node --test .opencode/scripts/runtime-foreign-repo.test.mts && node .opencode/scripts/portable-harness.test.mjs && node .opencode/scripts/validate-harness.mts && node .opencode/scripts/validate-portable-harness.mjs --root .",
    "test": "npm run check:format && npm run typecheck && npm run check:generated && npm run check:source-policy && npm run test:harness"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.12.2",
    "eslint": "10.9.1",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0"
  },
  "prettier": {
    "printWidth": 100,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "endOfLine": "lf"
  }
}
