{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "global.manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "profile",
    "protocolVersion",
    "assets"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "profile": {
      "const": "global-native"
    },
    "protocolVersion": {
      "const": "1.0.0"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "release",
          "kind"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "release": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "discovery": {
            "type": "string",
            "pattern": "^(agents|commands|skills|plugins)/"
          }
        }
      }
    }
  }
}
