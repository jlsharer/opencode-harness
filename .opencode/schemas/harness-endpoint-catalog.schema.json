{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode-harness.local/schemas/harness-endpoint-catalog.schema.json",
  "title": "OpenCode Harness Endpoint Catalog",
  "type": "object",
  "required": ["schemaVersion", "models"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "models": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^ai-infra-[a-z][a-z0-9-]{0,31}$" },
      "additionalProperties": { "$ref": "#/$defs/catalogEntry" }
    }
  },
  "$defs": {
    "catalogEntry": {
      "type": "object",
      "required": ["model", "routingServiceUrl", "maxInFlight"],
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "pattern": "^ai-infra-[a-z][a-z0-9-]{0,31}/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
        "routingServiceUrl": {
          "type": "string",
          "pattern": "^http://127\\.0\\.0\\.1:(?:[1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])/v1$"
        },
        "maxInFlight": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
      }
    }
  }
}
