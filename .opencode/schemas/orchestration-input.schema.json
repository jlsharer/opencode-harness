{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode-harness.local/schemas/orchestration-input.schema.json",
  "title": "OpenCode Harness Orchestration Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "orchestrationId", "goal", "deliverables", "nonGoals", "workUnits", "allowedPaths", "acceptanceGates", "roleModeTaskMapping", "dag", "budgets", "scopeExpansion", "authorization", "routingMetadataStatus"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "orchestrationId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "goal": { "type": "string", "minLength": 1 },
    "deliverables": { "$ref": "#/$defs/nonemptyStrings" },
    "nonGoals": { "$ref": "#/$defs/nonemptyStrings" },
    "allowedPaths": { "$ref": "#/$defs/nonemptyStrings" },
    "acceptanceGates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "criterion", "evidenceCommand", "workUnitIds"],
        "properties": {
          "id": { "$ref": "#/$defs/id" }, "criterion": { "type": "string", "minLength": 1 },
          "evidenceCommand": { "type": "string", "minLength": 1 }, "workUnitIds": { "$ref": "#/$defs/nonemptyIds" }
        }
      }
    },
    "workUnits": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "goal", "deliverable", "nonGoals", "allowedPaths", "acceptanceGateIds"],
        "properties": {
          "id": { "$ref": "#/$defs/id" }, "goal": { "type": "string", "minLength": 1 },
          "deliverable": { "type": "string", "minLength": 1 }, "nonGoals": { "$ref": "#/$defs/nonemptyStrings" },
          "allowedPaths": { "$ref": "#/$defs/nonemptyStrings" }, "acceptanceGateIds": { "$ref": "#/$defs/nonemptyIds" }
        }
      }
    },
    "roleModeTaskMapping": {
      "type": "array", "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/researchMapping" }, { "$ref": "#/$defs/plannerMapping" },
          { "$ref": "#/$defs/implementerMapping" }, { "$ref": "#/$defs/validatorMapping" }
        ]
      }
    },
    "dag": {
      "type": "object", "additionalProperties": false,
      "required": ["dependencies", "parallelism"],
      "properties": {
        "dependencies": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": false, "required": ["workUnitId", "dependsOn"], "properties": { "workUnitId": { "$ref": "#/$defs/id" }, "dependsOn": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true } } }
        },
        "parallelism": {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "authorization", "distinctCapacityEvidence"],
          "properties": {
            "mode": { "enum": ["serial", "parallel"] },
            "authorization": { "enum": ["explicit", "not-authorized"] },
            "distinctCapacityEvidence": { "type": ["string", "null"] }
          },
          "allOf": [{ "if": { "properties": { "mode": { "const": "parallel" } } }, "then": { "anyOf": [{ "properties": { "authorization": { "const": "explicit" } } }, { "required": ["distinctCapacityEvidence"], "properties": { "distinctCapacityEvidence": { "type": "string", "minLength": 1 } } }] } }]
        }
      }
    },
    "budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["defaultRemediationCyclesPerWorkUnit", "maxRemediationCyclesPerWorkUnit", "maxTotalLeafAgents", "maxLeafAgentsByRole"],
      "properties": {
        "defaultRemediationCyclesPerWorkUnit": { "const": 1 },
        "maxRemediationCyclesPerWorkUnit": { "type": "integer", "minimum": 0 },
        "maxTotalLeafAgents": { "type": "integer", "minimum": 1 },
        "maxLeafAgentsByRole": {
          "type": "object", "additionalProperties": false, "required": ["researcher", "planner", "implementer", "validator"],
          "properties": { "researcher": { "type": "integer", "minimum": 0 }, "planner": { "type": "integer", "minimum": 0 }, "implementer": { "type": "integer", "minimum": 0 }, "validator": { "type": "integer", "minimum": 0 } }
        }
      }
    },
    "scopeExpansion": {
      "type": "object", "additionalProperties": false, "required": ["policy", "requiresUserApproval"],
      "properties": { "policy": { "enum": ["deny", "explicit-only"] }, "requiresUserApproval": { "type": "boolean" } }
    },
    "authorization": {
      "type": "object", "additionalProperties": false, "required": ["liveProviders", "userGlobalMutation", "git"],
      "properties": {
        "liveProviders": { "type": "boolean" }, "userGlobalMutation": { "type": "boolean" },
        "git": { "type": "object", "additionalProperties": false, "required": ["commit", "amend", "push", "otherMutation"], "properties": { "commit": { "type": "boolean" }, "amend": { "type": "boolean" }, "push": { "type": "boolean" }, "otherMutation": { "type": "boolean" } } }
      }
    },
    "routingMetadataStatus": { "enum": ["present", "absent"] },
    "routingMetadata": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "routingMetadataStatus": { "const": "present" } } }, "then": { "required": ["routingMetadata"] }, "else": { "not": { "required": ["routingMetadata"] } } }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "nonemptyStrings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "nonemptyIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
    "mappingBase": {
      "type": "object", "additionalProperties": false,
      "required": ["workUnitId", "role", "taskMode", "boundedTask"],
      "properties": { "workUnitId": { "$ref": "#/$defs/id" }, "role": { "type": "string" }, "taskMode": { "type": "string" }, "boundedTask": { "type": "string", "minLength": 1 } }
    },
    "researchMapping": { "allOf": [{ "$ref": "#/$defs/mappingBase" }, { "properties": { "role": { "const": "researcher" }, "taskMode": { "const": "research" } } }] },
    "plannerMapping": { "allOf": [{ "$ref": "#/$defs/mappingBase" }, { "properties": { "role": { "const": "planner" }, "taskMode": { "enum": ["plan", "synthesis"] } } }] },
    "implementerMapping": { "allOf": [{ "$ref": "#/$defs/mappingBase" }, { "properties": { "role": { "const": "implementer" }, "taskMode": { "enum": ["implementation", "integration"] } } }] },
    "validatorMapping": { "allOf": [{ "$ref": "#/$defs/mappingBase" }, { "properties": { "role": { "const": "validator" }, "taskMode": { "enum": ["validation", "review", "artifact-proof", "integration-check"] } } }] }
  }
}
