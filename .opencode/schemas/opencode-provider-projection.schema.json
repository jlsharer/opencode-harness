{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-infrastructure.local/schemas/opencode-provider-projection.schema.json",
  "title": "OpenCode Provider Projection",
  "type": "object",
  "required": ["$schema", "provider"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "https://opencode.ai/config.json" },
    "provider": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^ai-infra-[a-z][a-z0-9-]{0,31}$": {
          "type": "object",
          "required": ["npm", "name", "options", "models"],
          "additionalProperties": false,
          "properties": {
            "npm": { "const": "@ai-sdk/openai-compatible" },
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "options": {
              "type": "object",
              "required": ["baseURL"],
              "additionalProperties": false,
              "properties": {
                "baseURL": {
                  "type": "string",
                  "pattern": "^http://127\\.0\\.0\\.1:(?:[1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])/v1$"
                }
              }
            },
            "models": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 1,
              "additionalProperties": false,
              "patternProperties": {
                "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$": {
                  "type": "object",
                  "required": ["name", "limit", "options"],
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
                    "limit": {
                      "type": "object",
                      "required": ["context", "output"],
                      "additionalProperties": false,
                      "properties": {
                        "context": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
                        "output": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
                      }
                    },
                    "options": {
                      "type": "object",
                      "required": ["chat_template_kwargs"],
                      "additionalProperties": false,
                      "properties": {
                        "chat_template_kwargs": {
                          "type": "object",
                          "required": ["enable_thinking"],
                          "additionalProperties": false,
                          "properties": {
                            "enable_thinking": { "type": "boolean" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
