{
  "$schema": "../schemas/role-io-contracts.schema.json",
  "schemaVersion": "0.2.0",
  "memoryProtocol": ".memory/protocols/memory-management.md",
  "traceArtifactSchema": ".opencode/schemas/memory-trace-artifact.schema.json",
  "tracePathTemplate": ".memory/orchestrations/<orchestration-id>/roles/<role>/<artifact-id>.md",
  "roles": {
    "researcher": {
      "taskModes": ["research"],
      "inputContract": {
        "required": ["orchestrationId", "delegationTaskId", "scopeKey", "dispatchKind", "taskMode", "scopedQuestion", "sourceConstraints", "freshnessRequirements", "downstreamNeeds", "routingMetadataStatus"],
        "optional": ["relevantPaths", "documentationTargets", "workspaceRoot", "runtimeRoot", "traceRoot"]
      },
      "outputContract": {
        "required": ["citedFindings", "sourceList", "implementationImplications", "risks", "recommendedNextRole", "traceArtifactPath"],
        "optional": ["unresolvedQuestions"]
      },
      "traceArtifact": {
        "requiredFields": ["orchestrationId", "role", "artifactId", "createdAt", "inputContract", "workPerformed", "outputContract", "handoff"],
        "pathTemplate": ".memory/orchestrations/<orchestration-id>/roles/researcher/<artifact-id>.md"
      },
      "verificationExpectations": ["Cite sources or supplied evidence.", "Distinguish direct evidence from inference.", "Do not edit files."]
    },
    "planner": {
      "taskModes": ["plan", "synthesis"],
      "inputContract": {
        "required": ["orchestrationId", "delegationTaskId", "scopeKey", "dispatchKind", "taskMode", "approvedGoal", "scopeBoundaries", "researchEvidence", "deliverablePaths", "acceptanceCriteria", "routingMetadataStatus"],
        "optional": ["dependencies", "assumptions", "conflictsOrDecisions", "roleOutputs", "workspaceRoot", "runtimeRoot", "traceRoot"]
      },
      "outputContract": {
        "required": ["orderedPlanOrResolvedConclusions", "fileContractsOrDecisions", "dependencies", "verificationGates", "handoffNotes", "traceArtifactPath"],
        "optional": ["openQuestions", "tradeoffs"]
      },
      "traceArtifact": {
        "requiredFields": ["orchestrationId", "role", "artifactId", "createdAt", "inputContract", "workPerformed", "outputContract", "handoff"],
        "pathTemplate": ".memory/orchestrations/<orchestration-id>/roles/planner/<artifact-id>.md"
      },
      "verificationExpectations": ["State the selected task mode.", "Specify exact target paths or evidence decisions.", "Keep acceptance gates executable.", "Do not edit implementation files."]
    },
    "implementer": {
      "taskModes": ["implementation", "integration"],
      "inputContract": {
        "required": ["orchestrationId", "delegationTaskId", "scopeKey", "dispatchKind", "taskMode", "approvedPlan", "targetPaths", "allowedEditScope", "schemaRequirements", "preservationRequirements", "verificationCommands", "routingMetadataStatus"],
        "optional": ["styleConstraints", "handoffRequirements", "pathRelationships", "manifestExpectations", "workspaceRoot", "runtimeRoot", "traceRoot"]
      },
      "outputContract": {
        "required": ["changedFiles", "rationale", "schemaOrBoundaryChoices", "commandsRun", "handoffNotes", "traceArtifactPath"],
        "optional": ["skippedChecks", "knownLimitations"]
      },
      "traceArtifact": {
        "requiredFields": ["orchestrationId", "role", "artifactId", "createdAt", "inputContract", "workPerformed", "outputContract", "handoff"],
        "pathTemplate": ".memory/orchestrations/<orchestration-id>/roles/implementer/<artifact-id>.md"
      },
      "verificationExpectations": ["State the selected task mode.", "Edit only assigned paths.", "Keep changes deterministic and diffable.", "Run assigned self-checks before handoff."]
    },
    "validator": {
      "taskModes": ["validation", "review", "artifact-proof", "integration-check"],
      "inputContract": {
        "required": ["orchestrationId", "delegationTaskId", "scopeKey", "dispatchKind", "taskMode", "changedFiles", "verificationCriteria", "commandsToRun", "schemaContracts", "acceptanceStandard", "routingMetadataStatus"],
        "optional": ["expectedWarnings", "skippedCheckPolicy", "riskAreas", "artifactExpectations", "pathRelationships", "workspaceRoot", "runtimeRoot", "traceRoot"]
      },
      "outputContract": {
        "required": ["passFailMatrixOrFindings", "commandOutputs", "schemaResults", "securityAndActivationFindings", "remediationList", "traceArtifactPath"],
        "optional": ["skippedChecks", "residualRisk", "artifactProof"]
      },
      "traceArtifact": {
        "requiredFields": ["orchestrationId", "role", "artifactId", "createdAt", "inputContract", "workPerformed", "outputContract", "handoff"],
        "pathTemplate": ".memory/orchestrations/<orchestration-id>/roles/validator/<artifact-id>.md"
      },
      "verificationExpectations": ["State the selected task mode.", "Run command-backed checks independently.", "Block only findings tied to the goal, an acceptance gate, or changed behavior.", "Treat hooks and progress artifacts as non-acceptance evidence.", "Do not implement fixes."]
    }
  }
}
