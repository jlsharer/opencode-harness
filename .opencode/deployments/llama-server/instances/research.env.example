# Illustrative only. Copy to research.env, then replace the digest and private path.
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp@sha256:<approved-digest>
HOST_PORT=8080
MODEL_DIR=/absolute/existing/private/research-model-directory
MODEL_FILE=replace-with-approved-research-model.gguf
MODEL_ALIAS=qwen2.5-7b-instruct
CTX_SIZE=8192
PARALLEL=1
CACHE_TYPE_K=f16
CACHE_TYPE_V=f16
FLASH_ATTN=auto
GPU_LAYERS=all
SPLIT_MODE=layer
TENSOR_SPLIT=1
MAIN_GPU=0
METRICS=true
