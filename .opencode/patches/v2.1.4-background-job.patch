diff --git a/packages/core/test/plugin/job-domain.test.ts b/packages/core/test/plugin/job-domain.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/core/test/plugin/job-domain.test.ts
@@ -0,0 +1,59 @@
+import { expect } from "bun:test"
+import { Job } from "@opencode/core/job"
+import { Plugin } from "@opencode/core/plugin"
+import { PluginHost } from "@opencode/core/plugin/host"
+import { fromPromise } from "@opencode/plugin/promise/adapter"
+import { Deferred, Effect } from "effect"
+import { testEffect } from "../lib/effect"
+import { PluginTestLayer } from "./fixture"
+
+const it = testEffect(PluginTestLayer)
+
+it.effect("plugin Job cancellation terminates only an active subagent Job", () =>
+  Effect.gen(function* () {
+    const jobs = yield* Job.Service
+    const plugins = yield* Plugin.Service
+    const host = yield* PluginHost.make(plugins)
+    const latch = yield* Deferred.make<string>()
+    yield* jobs.start({ id: "ses_bound_child", type: "subagent", run: Deferred.await(latch) })
+    yield* jobs.start({ id: "shell_foreign", type: "shell", run: Effect.never })
+
+    expect(yield* host.job.get({ id: "ses_bound_child" })).toMatchObject({ status: "running" })
+    expect(yield* host.job.wait({ id: "ses_bound_child", timeout: 0 })).toMatchObject({
+      timedOut: true,
+      info: { status: "running" },
+    })
+    expect(yield* Effect.exit(host.job.cancel({ id: "shell_foreign" }))).toMatchObject({ _tag: "Failure" })
+    expect(yield* host.job.cancel({ id: "ses_bound_child" })).toMatchObject({ status: "cancelled" })
+    expect(yield* host.job.wait({ id: "ses_bound_child" })).toMatchObject({
+      timedOut: false,
+      info: { status: "cancelled" },
+    })
+    expect(yield* jobs.get("shell_foreign")).toMatchObject({ status: "running" })
+    yield* jobs.cancel("shell_foreign")
+  }),
+)
+
+it.effect("Promise plugin observes terminal Job cancellation through its bound domain", () =>
+  Effect.gen(function* () {
+    const jobs = yield* Job.Service
+    const plugins = yield* Plugin.Service
+    const latch = yield* Deferred.make<string>()
+    yield* jobs.start({ id: "ses_promise_child", type: "subagent", run: Deferred.await(latch) })
+    let status: string | undefined
+    const plugin = fromPromise({
+      id: "test.plugin.job-domain",
+      setup: async (ctx) => {
+        const running = await ctx.job.get({ id: "ses_promise_child" })
+        expect(running?.status).toBe("running")
+        const cancelled = await ctx.job.cancel({ id: "ses_promise_child" })
+        const terminal = await ctx.job.wait({ id: "ses_promise_child", timeout: 1000 })
+        expect(cancelled?.status).toBe("cancelled")
+        expect(terminal.timedOut).toBe(false)
+        status = terminal.info?.status
+      },
+    })
+    yield* plugin.effect(yield* PluginHost.make(plugins))
+    expect(status).toBe("cancelled")
+  }),
+)
