diff --git a/packages/plugin/src/effect/job.ts b/packages/plugin/src/effect/job.ts
new file mode 100644
--- /dev/null
+++ b/packages/plugin/src/effect/job.ts
@@ -0,0 +1,18 @@
+import type { Effect } from "effect"
+
+export interface JobInfo {
+  readonly id: string
+  readonly type: string
+  readonly status: "running" | "completed" | "error" | "cancelled"
+  readonly started_at: number
+  readonly completed_at?: number
+  readonly output?: string
+  readonly error?: string
+}
+
+/** Bound subagent Job state; consumers must separately verify the child session's parent. */
+export interface JobDomain {
+  readonly get: (input: { id: string }) => Effect.Effect<JobInfo | undefined, Error>
+  readonly wait: (input: { id: string; timeout?: number }) => Effect.Effect<{ info?: JobInfo; timedOut: boolean }, Error>
+  readonly cancel: (input: { id: string }) => Effect.Effect<JobInfo | undefined, Error>
+}
